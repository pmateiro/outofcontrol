[Unit]
Description=OutOfControl local agent API (GNOME copilot backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/outofcontrol/app
Environment=PATH=%h/.local/share/outofcontrol/venv/bin:/usr/bin
EnvironmentFile=-%h/.config/outofcontrol/env
ExecStart=%h/.local/share/outofcontrol/venv/bin/outofcontrol serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
